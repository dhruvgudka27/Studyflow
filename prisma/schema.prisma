// Prisma Schema for StudyFlow Platform
// Multi-Entity Normalized Relational Model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum TransactionType {
  CREDIT_ALLOCATION
  RESOURCE_UNLOCK
  LAB_ALLOWANCE
  RESEARCH_GRANT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmailEventType {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          Role      @default(MEMBER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relational associations
  sessions       Session[]
  accounts       Account[]
  courses        Course[]
  tasks          StudyTask[]
  goals          AcademicGoal[]
  studySessions  StudySession[]
  transactions   Transaction[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  description String?
  instructor  String
  color       String   @default("#3b82f6") // Hex or theme token
  credits     Int      @default(3)
  semester    String   @default("Sem V")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks StudyTask[]

  @@unique([userId, code])
  @@index([userId])
}

model StudyTask {
  id               String       @id @default(cuid())
  title            String
  description      String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(TODO)
  dueDate          DateTime
  estimatedMinutes Int          @default(60)
  completedAt      DateTime?
  courseId         String
  userId           String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions StudySession[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([courseId])
}

model AcademicGoal {
  id                 String     @id @default(cuid())
  title              String
  description        String?
  targetDate         DateTime
  progressPercentage Int        @default(0)
  status             GoalStatus @default(ACTIVE)
  userId             String
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model StudySession {
  id              String   @id @default(cuid())
  title           String
  durationMinutes Int
  notes           String?
  focusScore      Int      @default(100) // 0 to 100 focus rating
  taskId          String?
  userId          String
  createdAt       DateTime @default(now())

  task StudyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Transaction {
  id            String            @id @default(cuid())
  userId        String
  type          TransactionType
  amount        Decimal           @db.Decimal(10, 2)
  description   String
  status        TransactionStatus @default(COMPLETED)
  referenceCode String            @unique
  createdAt     DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([referenceCode])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g. "TASK_CREATED", "SESSION_LOGIN", "ROLE_UPDATED"
  entityType String   // e.g. "StudyTask", "User", "Course"
  entityId   String?
  details    Json?    // Detailed JSON payload for audit forensics
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType])
}

model EmailDeliveryLog {
  id              String         @id @default(cuid())
  recipientEmail  String
  templateName    String
  subject         String
  status          EmailEventType @default(SENT)
  resendMessageId String?        @unique
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([recipientEmail])
  @@index([resendMessageId])
  @@index([status])
}
