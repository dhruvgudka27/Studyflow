# ==========================================
# StudyFlow Environment Configuration
# ==========================================

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studyflow?schema=public"

# MongoDB Connection (Mongoose Document Database)
# In development, an in-memory/embedded MongoDB instance will automatically spin up if no URI is supplied.
MONGODB_URI="mongodb://localhost:27017/studyflow_telemetry"

# Better Auth Configuration & Secret
BETTER_AUTH_SECRET="studyflow_super_secret_jwt_encryption_key_2026_aiml"
BETTER_AUTH_URL="http://localhost:3000"

# Transactional Email (Resend)
# Optional in development - if unset, transactional emails log cleanly to the development console & DB
RESEND_API_KEY="re_test_dummy_key_studyflow_2026"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_WEBHOOK_SECRET="whsec_studyflow_dummy_webhook_secret_2026"
